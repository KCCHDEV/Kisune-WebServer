{
  "name": "kitsune",
  "version": "1.0.0",
  "description": "Kitsune — ว่องไว แสนกล ครบในตัวเดียว · Full-stack starter บน Bun + Elysia + htmx โดย Yurachi Studio",
  "author": "Yurachi Studio",
  "license": "MIT",
  "homepage": "https://github.com/KCCHDEV/Kisune-WebServer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KCCHDEV/Kisune-WebServer.git"
  },
  "bugs": {
    "url": "https://github.com/KCCHDEV/Kisune-WebServer/issues"
  },
  "keywords": [
    "bun",
    "elysia",
    "htmx",
    "typescript",
    "jsx",
    "sqlite",
    "fullstack",
    "starter",
    "ssr",
    "cache",
    "webgl"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --watch index.tsx",
    "start": "NODE_ENV=production bun index.tsx",
    "start:cluster": "bun scripts/cluster.ts",
    "test": "bun test",
    "bench": "bun scripts/bench.ts",
    "trailer": "bun scripts/trailer.ts",
    "tutorial": "bun scripts/trailer.ts --tutorial",
    "check": "tsc --noEmit && xss-scan",
    "setup": "bun scripts/setup/index.ts"
  },
  "dependencies": {
    "@elysiajs/html": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@kitajs/html": "^4.2.13",
    "elysia": "^1.4.30",
    "htmx-ext-preload": "^2.1.2",
    "htmx-ext-sse": "2.2.2",
    "htmx-ext-ws": "2.0.2",
    "htmx.org": "2.0.4",
    "mp4-muxer": "^5.2.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@kitajs/ts-html-plugin": "^4.1.4",
    "@types/bun": "^1.4.4",
    "@types/three": "^0.186.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "5"
  },
  "bun-create": {
    "postinstall": "bun scripts/setup/index.ts --from-create"
  }
}
