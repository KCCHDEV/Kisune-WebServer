    "mp4-muxer": "^5.2.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
